{
  "name": "cloud-storage",
  "version": "1.0.0",
  "description": "Cloud storage integration with Google Drive and Mega support",
  "author": "RaspiPot Team",
  "main": "index.js",
  "category": "Tools",
  "permissions": ["network", "filesystem", "notifications"],
  "hooks": ["onHttpRequest"],
  "settings": {
    "gdrive": {
      "enabled": false,
      "clientId": "",
      "clientSecret": "",
      "redirectUri": "http://localhost:3000/api/cloud-storage/gdrive/callback"
    },
    "mega": {
      "enabled": false,
      "email": "",
      "password": ""
    },
    "uploadPath": "./uploads",
    "maxFileSize": "100MB"
  },
  "dependencies": {
    "googleapis": "^128.0.0",
    "megajs": "^1.1.0",
    "multer": "^1.4.5",
    "express": "^4.18.2"
  }
}

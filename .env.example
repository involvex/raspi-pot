JWT_SECRET=your_secret_here
ADMIN_PASSWORD=raspberry
PORT=3000

# --- Pi-hole v6 integration -------------------------------------------------
# Base URL of the embedded pihole-FTL web server. Defaults to port 80.
# If you kept lighttpd on port 80, Pi-hole falls back to 8080 - use that here.
# Prefer 127.0.0.1 over "localhost": Node may resolve localhost to ::1 first
# while pihole-FTL only listens on IPv4. Run `npm run doctor` if unsure.
PIHOLE_URL=http://127.0.0.1

# Web/app password set with `pihole setpassword ...`. Use an app password
# (Settings -> API) if you enabled 2FA on the regular password. Leave empty
# only if your Pi-hole has no password configured.
PIHOLE_APP_PASSWORD=

# Set to false only when PIHOLE_URL is https with a self-signed certificate.
PIHOLE_VERIFY_TLS=false

# Second port that proxies the official Pi-hole admin UI for the iframe tab.
PIHOLE_ADMIN_PROXY_PORT=8081
PIHOLE_ENABLE_PROXY=true

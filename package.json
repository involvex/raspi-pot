    "concurrently": "^9.2.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "fs-extra": "^11.3.3",
    "googleapis": "^128.0.0",
    "jsonwebtoken": "^9.0.3",
    "megajs": "^1.1.0",
    "multer": "^2.0.2",
    "node-pty": "^1.1.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "systeminformation": "^5.30.7",
